# Copy to .env. Never commit real credentials.
HOST=127.0.0.1
PORT=3002
PUBLIC_BASE_URL=http://127.0.0.1:3002
DEEPSEEK_API_KEY=
# Optional voice. Choose a voice you may use on your own provider account.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Optional embeddings; lexical recall works without this service.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/embeddings
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=256
# Included example; override this path to use another compatible model.
LIVE2D_MODEL_PATH=/live2d/fox/fox.model3.json
# Empty means administrative access is disabled.
ADMIN_SECRET_KEY=
# Background contact and maintenance jobs are off in the local demo.
ENABLE_BACKGROUND_JOBS=false
